# Firebase Admin SDK credentials used only by Vercel serverless functions.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@your-firebase-project-id.iam.gserviceaccount.com"
# Preserve escaped newlines when storing this in Vercel.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Web API key used by the server-only Firebase Authentication password exchange.
FIREBASE_WEB_API_KEY="your-firebase-web-api-key"

# A unique, high-entropy secret (at least 32 random bytes) for signed admin sessions.
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# Optional local development configuration.
APP_URL="http://localhost:5173"


